# Valores ficticios, únicamente para desarrollo local.
DB_NAME=reclamos
DB_USER=reclamos
DB_PASSWORD=reclamos_dev
MYSQL_ROOT_PASSWORD=root_dev
DB_PORT=3306

# Servicio de prioridad con IA (REST 2). La clave gratuita se crea en Google AI Studio.
# Nunca commitear la clave: .env está en .gitignore. Con el nivel gratuito, Google puede usar el
# contenido para mejorar sus productos: usar solo datos de prueba.
PRIORIDAD_IA_PROVEEDOR=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
