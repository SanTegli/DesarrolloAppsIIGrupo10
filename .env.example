# Valores ficticios, únicamente para desarrollo local.
DB_NAME=reclamos
DB_USER=reclamos
DB_PASSWORD=reclamos_dev
MYSQL_ROOT_PASSWORD=root_dev
DB_PORT=3306

# Servicio de prioridad con IA (REST 2). La clave gratuita se crea en Google AI Studio.
# Nunca commitear la clave: .env está en .gitignore. Con el nivel gratuito, Google puede usar el
# contenido para mejorar sus productos: usar solo datos de prueba.
PRIORIDAD_IA_PROVEEDOR=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# RabbitMQ (mensajería). El usuario guest de RabbitMQ solo entra desde el mismo contenedor, así que Compose
# crea este usuario. Valores ficticios, solo para desarrollo.
RABBITMQ_USER=reclamos
RABBITMQ_PASSWORD=reclamos_dev

# Verificación del teléfono por Telegram. Con "simulado" (el valor por defecto) no hace falta nada: el número
# se escribe en la interfaz. Para usar el bot real: crearlo con @BotFather, poner el modo en "telegram" y
# completar el token y el usuario del bot (sin @). Nunca commitear el token.
RECLAMOS_TELEGRAM_MODO=simulado
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USUARIO=
