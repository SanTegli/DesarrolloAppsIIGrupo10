<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/>
    </parent>

    <groupId>ar.edu.uade.reclamos</groupId>
    <artifactId>reclamos-urbanos</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Sistema de Reclamos Urbanos</name>
    <description>TPO Desarrollo de Aplicaciones II - Grupo 10</description>

    <!-- Cada módulo es un componente con artefacto propio. El orden refleja las dependencias. -->
    <modules>
        <module>reclamos-comun</module>
        <module>reclamos-dominio</module>
        <module>reclamos-persistencia</module>
        <module>reclamos-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ar.edu.uade.reclamos</groupId>
                <artifactId>reclamos-comun</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ar.edu.uade.reclamos</groupId>
                <artifactId>reclamos-dominio</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ar.edu.uade.reclamos</groupId>
                <artifactId>reclamos-persistencia</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
