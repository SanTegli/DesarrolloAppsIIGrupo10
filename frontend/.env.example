# Copiar a .env solo si hace falta cambiar algún valor.

# Adónde reenvía Vite las llamadas a /api (backend Spring o API simulada).
VITE_BACKEND_URL=http://localhost:8080

# URL base que usa el navegador. Dejar /api para pasar por el proxy de Vite.
# Si se pone una URL absoluta de otro origen, el backend debe habilitar CORS.
VITE_API_URL=/api
